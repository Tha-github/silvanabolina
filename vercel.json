{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key":"Strict-Transport-Security","value":"max-age=31536000; includeSubDomains"},
        {"key":"Content-Security-Policy","value":"default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src https://www.google.com; form-action 'self' https://wa.me https://api.whatsapp.com; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests"},
        {"key":"X-Content-Type-Options","value":"nosniff"},
        {"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},
        {"key":"Permissions-Policy","value":"camera=(), microphone=(), geolocation=(), interest-cohort=()"},
        {"key":"X-Frame-Options","value":"DENY"},
        {"key":"Cross-Origin-Opener-Policy","value":"same-origin"}
      ]
    },
    {"source":"/politica-de-privacidade.html","headers":[{"key":"X-Robots-Tag","value":"noindex, follow"}]},
    {"source":"/404.html","headers":[{"key":"X-Robots-Tag","value":"noindex, nofollow"}]}
  ]
}
